server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 6m;
    # Docker embedded DNS: resolve API on demand so the SPA can boot even
    # while the API is absent/restarting. Nginx retries on later requests.
    resolver 127.0.0.11 valid=10s ipv6=off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    location /api/ {
        # Variable upstream defers DNS until request time; static files stay up.
        set $api_backend "api:8000";
        # Preserve previous /api/v1/... -> /v1/... upstream mapping.
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$api_backend;
        proxy_set_header Host $host;
        proxy_set_header X-API-Key "$API_TOKEN";
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
    location / { try_files $uri $uri/ /index.html; }
}
