# Server template: replace the token and pinned MODEL_REVISION before startup.
# UI binds on LAN. Restrict 8086 to trusted LAN clients in your firewall / ingress.
# The UI proxy carries a backend API key but DOES NOT authenticate browser users.
APP_ENV=production
API_AUTH_ENABLED=true
API_TOKEN=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_32_CHARS
API_BIND_IP=127.0.0.1
API_PORT=8005
UI_BIND_IP=0.0.0.0
UI_PORT=8086
MODEL_ID=ibm-granite/granite-timeseries-ttm-r3
MODEL_PATH=/models/granite-ttm-r3
MODEL_REVISION=
CPU_THREADS=2
API_CPUS=2.0
API_MEMORY=2g
UI_CPUS=0.5
UI_MEMORY=256m
MAX_CONCURRENT_INFERENCE=1
MAX_QUEUE_WAIT_SECONDS=10
MAX_ROWS=10000
MAX_UPLOAD_MB=5
MAX_BATCH_SERIES=8
MAX_MISSING_FRACTION=0.05
MAX_BACKTEST_WINDOWS=3
PIP_PRIMARY_INDEX_URL=https://package-mirror.liara.ir/repository/pypi/simple
PIP_FALLBACK_INDEX_URL=https://mirror2.chabokan.net/pypi/simple/
TORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu
