# Local development. Never commit .env or secrets.
APP_ENV=development
API_AUTH_ENABLED=true
API_TOKEN=REPLACE_WITH_LOCAL_RANDOM_SECRET_32_CHARS
API_BIND_IP=127.0.0.1
API_PORT=8005
UI_BIND_IP=127.0.0.1
UI_PORT=8086
MODEL_ID=ibm-granite/granite-timeseries-ttm-r3
MODEL_PATH=/models/granite-ttm-r3
# Set to the exact 40-character SHA from .models/granite-ttm-r3/manifest.json after make model
MODEL_REVISION=
CPU_THREADS=2
API_CPUS=2.0
API_MEMORY=2g
UI_CPUS=0.5
UI_MEMORY=256m
MAX_CONCURRENT_INFERENCE=1
MAX_QUEUE_WAIT_SECONDS=10
MAX_ROWS=10000
MAX_UPLOAD_MB=5
MAX_BATCH_SERIES=8
MAX_MISSING_FRACTION=0.05
MAX_BACKTEST_WINDOWS=3
# Project-scoped mirrors for Python packages (not Hugging Face weights, npm, or Docker images).
PIP_PRIMARY_INDEX_URL=https://package-mirror.liara.ir/repository/pypi/simple
PIP_FALLBACK_INDEX_URL=https://mirror2.chabokan.net/pypi/simple/
# CPU-only torch wheels have a separate official index; override with your vetted CPU wheel mirror if available.
TORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu
